@model FurniCraft.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-speedometer2 text-primary me-2"></i>
                لوحة التحكم
            </h1>

            <p class="text-muted mb-0">
                نظرة سريعة على حالة المتجر والطلبات والمنتجات.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Products"
               asp-action="Create"
               class="btn btn-fc-primary">
                <i class="bi bi-plus-lg me-1"></i>
                إضافة منتج
            </a>

            <a asp-controller="Orders"
               asp-action="AdminIndex"
               class="btn btn-fc-outline">
                <i class="bi bi-receipt me-1"></i>
                إدارة الطلبات
            </a>
        </div>
    </div>


    <!-- Main Statistics -->
    <div class="row g-4 mb-4">

        <!-- Products -->
        <div class="col-sm-6 col-xl-3">
            <div class="fc-card h-100 p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-2">إجمالي المنتجات</p>

                        <h2 class="fw-bold mb-1">
                            @Model.TotalProducts
                        </h2>

                        <small class="text-muted">
                            كل المنتجات المسجلة
                        </small>
                    </div>

                    <div class="fs-2 text-primary">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>


        <!-- Orders -->
        <div class="col-sm-6 col-xl-3">
            <div class="fc-card h-100 p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-2">إجمالي الطلبات</p>

                        <h2 class="fw-bold mb-1">
                            @Model.TotalOrders
                        </h2>

                        <small class="text-muted">
                            جميع الطلبات
                        </small>
                    </div>

                    <div class="fs-2 text-primary">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                </div>
            </div>
        </div>


        <!-- Users -->
        <div class="col-sm-6 col-xl-3">
            <div class="fc-card h-100 p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-2">المستخدمون</p>

                        <h2 class="fw-bold mb-1">
                            @Model.TotalUsers
                        </h2>

                        <small class="text-muted">
                            حسابات العملاء
                        </small>
                    </div>

                    <div class="fs-2 text-primary">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>


        <!-- Revenue -->
        <div class="col-sm-6 col-xl-3">
            <div class="fc-card h-100 p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-2">إجمالي الإيرادات</p>

                        <h2 class="fw-bold mb-1">
                            @Model.TotalRevenue.ToString("N0")
                        </h2>

                        <small class="text-muted">
                            جنيه مصري
                        </small>
                    </div>

                    <div class="fs-2 text-success">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- Secondary Statistics -->
    <div class="row g-4 mb-4">

        <!-- Active Products -->
        <div class="col-md-6 col-xl-3">
            <div class="fc-card h-100 p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-3 text-success">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <div>
                        <p class="text-muted mb-1">المنتجات النشطة</p>

                        <h4 class="fw-bold mb-0">
                            @Model.ActiveProducts
                        </h4>
                    </div>
                </div>
            </div>
        </div>


        <!-- Low Stock -->
        <div class="col-md-6 col-xl-3">
            <div class="fc-card h-100 p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-3 text-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>

                    <div>
                        <p class="text-muted mb-1">مخزون منخفض</p>

                        <h4 class="fw-bold mb-0">
                            @Model.LowStockProducts
                        </h4>
                    </div>
                </div>
            </div>
        </div>


        <!-- Pending Orders -->
        <div class="col-md-6 col-xl-3">
            <div class="fc-card h-100 p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-3 text-info">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                    <div>
                        <p class="text-muted mb-1">طلبات قيد الانتظار</p>

                        <h4 class="fw-bold mb-0">
                            @Model.PendingOrders
                        </h4>
                    </div>
                </div>
            </div>
        </div>


        <!-- Delivered Orders -->
        <div class="col-md-6 col-xl-3">
            <div class="fc-card h-100 p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-3 text-success">
                        <i class="bi bi-bag-check"></i>
                    </div>

                    <div>
                        <p class="text-muted mb-1">طلبات تم تسليمها</p>

                        <h4 class="fw-bold mb-0">
                            @Model.DeliveredOrders
                        </h4>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- Recent Orders + Quick Actions -->
    <div class="row g-4">

        <!-- Recent Orders -->
        <div class="col-xl-8">

            <div class="fc-card">

                <div class="p-4 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h5 class="fw-bold mb-1">
                                <i class="bi bi-clock-history text-primary me-2"></i>
                                أحدث الطلبات
                            </h5>

                            <small class="text-muted">
                                آخر الطلبات التي تم تسجيلها في المتجر
                            </small>
                        </div>

                        <a asp-controller="Orders"
                           asp-action="AdminIndex"
                           class="btn btn-sm btn-fc-outline">
                            عرض الكل
                        </a>

                    </div>
                </div>


                @if (Model.RecentOrders.Any())
                {
                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>الطلب</th>
                                <th>العميل</th>
                                <th>الإجمالي</th>
                                <th>الحالة</th>
                                <th>التاريخ</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var order in Model.RecentOrders)
                                {
                            <tr>

                                <td>
                                    <span class="fw-bold text-primary">
                                        #@order.OrderNumber
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        @order.CustomerName
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-bold">
                                        @order.TotalAmount.ToString("N0") ج.م
                                    </span>
                                </td>

                                <td>
                                    @if (order.Status == "Pending")
                                            {
                                    <span class="badge bg-warning text-dark">
                                        قيد الانتظار
                                    </span>
                                            }
                                            else if (order.Status == "Processing")
                                            {
                                    <span class="badge bg-info text-dark">
                                        قيد التحضير
                                    </span>
                                            }
                                            else if (order.Status == "Shipped")
                                            {
                                    <span class="badge bg-primary">
                                        تم الشحن
                                    </span>
                                            }
                                            else if (order.Status == "Delivered")
                                            {
                                    <span class="badge bg-success">
                                        تم التسليم
                                    </span>
                                            }
                                            else if (order.Status == "Cancelled")
                                            {
                                    <span class="badge bg-danger">
                                        ملغي
                                    </span>
                                            }
                                            else
                                            {
                                    <span class="badge bg-secondary">
                                        @order.Status
                                    </span>
                                            }
                                </td>

                                <td>
                                    <small class="text-muted">
                                        @order.OrderDate.ToLocalTime().ToString("yyyy/MM/dd")
                                    </small>
                                </td>

                            </tr>
                                }

                        </tbody>

                    </table>

                </div>
                }
                else
                {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted"></i>

                    <h6 class="fw-bold mt-3">
                        لا توجد طلبات حتى الآن
                    </h6>

                    <p class="text-muted mb-0">
                        ستظهر الطلبات الجديدة هنا.
                    </p>
                </div>
                }

            </div>

        </div>


        <!-- Quick Actions -->
        <div class="col-xl-4">

            <div class="fc-card p-4 h-100">

                <h5 class="fw-bold mb-1">
                    <i class="bi bi-lightning-charge text-warning me-2"></i>
                    إجراءات سريعة
                </h5>

                <p class="text-muted small mb-4">
                    الوصول السريع لأهم أجزاء لوحة التحكم.
                </p>


                <div class="d-grid gap-3">

                    <a asp-controller="Products"
                       asp-action="AdminIndex"
                       class="btn btn-fc-primary">
                        <i class="bi bi-box-seam me-2"></i>
                        إدارة المنتجات
                    </a>


                    <a asp-controller="Products"
                       asp-action="Create"
                       class="btn btn-fc-outline">
                        <i class="bi bi-plus-circle me-2"></i>
                        إضافة منتج جديد
                    </a>


                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="btn btn-fc-outline">
                        <i class="bi bi-grid me-2"></i>
                        إدارة التصنيفات
                    </a>


                    <a asp-controller="Orders"
                       asp-action="AdminIndex"
                       class="btn btn-fc-outline">
                        <i class="bi bi-receipt-cutoff me-2"></i>
                        إدارة الطلبات
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>