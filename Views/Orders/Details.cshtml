@model FurniCraft.Models.Order

@{
    ViewData["Title"] = "تفاصيل الطلب";
}

<div class="container my-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-receipt text-primary me-2"></i>
                تفاصيل الطلب
            </h2>

            <p class="text-muted mb-0">
                #@Model.OrderNumber
            </p>
        </div>

        <a asp-action="AdminIndex"
           class="btn btn-fc-outline">

            <i class="bi bi-arrow-right me-1"></i>
            العودة للطلبات

        </a>

    </div>


    <!-- Order Info -->
    <div class="row g-4">

        <!-- Customer Information -->
        <div class="col-lg-4">

            <div class="fc-card p-4 h-100">

                <h5 class="fw-bold mb-4">
                    <i class="bi bi-person me-2 text-primary"></i>
                    بيانات العميل
                </h5>

                <div class="mb-3">

                    <small class="text-muted d-block">
                        الاسم
                    </small>

                    <span class="fw-bold">
                        @Model.CustomerName
                    </span>

                </div>

                <div class="mb-3">

                    <small class="text-muted d-block">
                        رقم الهاتف
                    </small>

                    <span>
                        @Model.Phone
                    </span>

                </div>

                <div class="mb-3">

                    <small class="text-muted d-block">
                        المدينة
                    </small>

                    <span>
                        @Model.City
                    </span>

                </div>

                <div class="mb-3">

                    <small class="text-muted d-block">
                        العنوان
                    </small>

                    <span>
                        @Model.Address
                    </span>

                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                <div>

                    <small class="text-muted d-block">
                        ملاحظات
                    </small>

                    <span>
                        @Model.Notes
                    </span>

                </div>
                }

            </div>

        </div>


        <!-- Order Summary -->
        <div class="col-lg-8">

            <div class="fc-card p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-box-seam me-2 text-primary"></i>
                        المنتجات
                    </h5>

                    @if (Model.Status == "Pending")
                    {
                    <span class="badge bg-warning text-dark">
                        قيد الانتظار
                    </span>
                    }
                    else if (Model.Status == "Processing")
                    {
                    <span class="badge bg-info text-dark">
                        قيد التحضير
                    </span>
                    }
                    else if (Model.Status == "Shipped")
                    {
                    <span class="badge bg-primary">
                        تم الشحن
                    </span>
                    }
                    else if (Model.Status == "Delivered")
                    {
                    <span class="badge bg-success">
                        تم التسليم
                    </span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                    <span class="badge bg-danger">
                        ملغي
                    </span>
                    }

                </div>


                @foreach (var item in Model.Items)
                {
                <div class="border rounded-3 p-3 mb-3">

                    <div class="row align-items-center">

                        <!-- Product -->
                        <div class="col-md-2">

                            <img src="@(item.Product?.MainImage ?? "/images/products/default.jpg")"
                                 class="rounded"
                                 style="width:80px;height:80px;object-fit:cover;"
                                 onerror="this.src='/images/products/default.jpg'"
                                 alt="@item.Product?.Name" />

                        </div>


                        <!-- Product Name -->
                        <div class="col-md-4">

                            <h6 class="fw-bold mb-1">
                                @item.Product?.Name
                            </h6>

                            <small class="text-muted">
                                الكمية: @item.Quantity
                            </small>

                        </div>


                        <!-- Unit Price -->
                        <div class="col-md-3">

                            <small class="text-muted d-block">
                                سعر الوحدة
                            </small>

                            <span class="fw-bold">
                                @item.UnitPrice.ToString("N0") ج.م
                            </span>

                        </div>


                        <!-- Total -->
                        <div class="col-md-3 text-md-end">

                            <small class="text-muted d-block">
                                الإجمالي
                            </small>

                            <span class="fw-bold text-success">
                                @item.TotalPrice.ToString("N0") ج.م
                            </span>

                        </div>

                    </div>


                    <!-- Customizations -->
                    @if (item.Customizations.Any())
                        {
                    <div class="mt-3 pt-3 border-top">

                        <small class="text-muted d-block mb-2">
                            التخصيصات:
                        </small>

                        <div class="d-flex flex-wrap gap-2">

                            @foreach (var customization in item.Customizations)
                                    {
                            <span class="badge bg-light text-dark border">

                                @customization.GroupName:
                                @customization.OptionName

                                @if (customization.AdditionalPrice > 0)
                                            {
                                <span class="text-success">
                                    (+@customization.AdditionalPrice.ToString("N0") ج.م)
                                </span>
                                            }

                            </span>
                                    }

                        </div>

                    </div>
                        }

                </div>
                }


                <!-- Total -->
                <div class="border-top pt-4 mt-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <span class="fw-bold fs-5">
                            إجمالي الطلب
                        </span>

                        <span class="fw-bold fs-4 text-success">
                            @Model.TotalAmount.ToString("N0") ج.م
                        </span>

                    </div>

                    <div class="text-muted small mt-2">
                        طريقة الدفع:
                        <strong>
                            الدفع عند الاستلام
                        </strong>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>