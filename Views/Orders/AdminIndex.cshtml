@model IEnumerable<FurniCraft.Models.Order>

    @{
    ViewData["Title"] = "إدارة الطلبات";
    }

    <div class="container my-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-receipt-cutoff text-primary me-2"></i>
                    إدارة طلبات العملاء
                </h2>

                <p class="text-muted mb-0">
                    متابعة الطلبات وتحديث حالتها
                </p>
            </div>

            <span class="badge bg-light text-dark fs-6">
                @Model.Count() طلب
            </span>

        </div>


        <div class="fc-card p-3">

            <div class="table-responsive">

                <table class="table align-middle table-hover mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>رقم الطلب</th>
                            <th>العميل</th>
                            <th>الهاتف / المدينة</th>
                            <th>الإجمالي</th>
                            <th>التاريخ</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-5">

                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                                لا توجد طلبات حالياً.

                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var order in Model)
                        {
                        <tr>

                            <!-- رقم الطلب -->
                            <td>
                                <span class="fw-bold text-primary">
                                    #@order.OrderNumber
                                </span>
                            </td>


                            <!-- العميل -->
                            <td>
                                <div class="fw-bold">
                                    @order.CustomerName
                                </div>
                            </td>


                            <!-- الهاتف والمدينة -->
                            <td class="small">

                                <div>
                                    <i class="bi bi-telephone me-1"></i>
                                    @order.Phone
                                </div>

                                <div class="text-muted">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    @order.City
                                </div>

                            </td>


                            <!-- الإجمالي -->
                            <td>
                                <span class="fw-bold text-success">
                                    @order.TotalAmount.ToString("N0") ج.م
                                </span>
                            </td>


                            <!-- التاريخ -->
                            <td class="small text-muted">

                                @order.OrderDate
                                .ToLocalTime()
                                .ToString("yyyy/MM/dd")

                                <br />

                                @order.OrderDate
                                .ToLocalTime()
                                .ToString("hh:mm tt")

                            </td>


                            <!-- الحالة -->
                            <td>

                                @if (order.Status == "Pending")
                                    {
                                <span class="badge bg-warning text-dark">
                                    قيد الانتظار
                                </span>
                                    }
                                    else if (order.Status == "Processing")
                                    {
                                <span class="badge bg-info text-dark">
                                    قيد التحضير
                                </span>
                                    }
                                    else if (order.Status == "Shipped")
                                    {
                                <span class="badge bg-primary">
                                    تم الشحن
                                </span>
                                    }
                                    else if (order.Status == "Delivered")
                                    {
                                <span class="badge bg-success">
                                    تم التسليم
                                </span>
                                    }
                                    else if (order.Status == "Cancelled")
                                    {
                                <span class="badge bg-danger">
                                    ملغي
                                </span>
                                    }
                                    else
                                    {
                                <span class="badge bg-secondary">
                                    @order.Status
                                </span>
                                    }

                            </td>


                            <!-- الإجراءات -->
                            <td>

                                <div class="d-flex gap-2">

                                    <!-- التفاصيل -->
                                    <a asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye me-1"></i>
                                        التفاصيل

                                    </a>


                                    <!-- تغيير الحالة -->
                                    <form asp-action="UpdateStatus"
                                          method="post"
                                          class="d-flex">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="orderId"
                                               value="@order.Id" />

                                        <select name="status"
                                                class="form-select form-select-sm"
                                                onchange="this.form.submit()">

                                            <option value="Pending"
                                                    selected="@(order.Status == "Pending")">
                                                قيد الانتظار
                                            </option>

                                            <option value="Processing"
                                                    selected="@(order.Status == "Processing")">
                                                قيد التحضير
                                            </option>

                                            <option value="Shipped"
                                                    selected="@(order.Status == "Shipped")">
                                                تم الشحن
                                            </option>

                                            <option value="Delivered"
                                                    selected="@(order.Status == "Delivered")">
                                                تم التسليم
                                            </option>

                                            <option value="Cancelled"
                                                    selected="@(order.Status == "Cancelled")">
                                                ملغي
                                            </option>

                                        </select>

                                    </form>

                                </div>

                            </td>

                        </tr>
                        }
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
