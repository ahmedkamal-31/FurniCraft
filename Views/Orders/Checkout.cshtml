@model FurniCraft.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "إتمام الطلب";
}

<div class="container my-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-credit-card-fill text-primary me-2"></i>إتمام طلب الشراء</h2>

    @if (ViewData.ModelState.TryGetValue(string.Empty, out var generalErrors)
        && generalErrors != null
        && generalErrors.Errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <div class="d-flex align-items-start">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <ul class="mb-0 ps-0 list-unstyled">
                    @foreach (var error in generalErrors.Errors)
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    }

    <form asp-action="PlaceOrder" method="post">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="fc-card p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-truck me-2 text-primary"></i>بيانات العنوان والشحن</h5>

                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label small fw-semibold"></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="أدخل اسمك الكامل" />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label small fw-semibold"></label>
                            <input asp-for="City" class="form-control" placeholder="القاهرة، الجيزة، الإسكندرية..." />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label small fw-semibold"></label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="اسم الشارع، رقم العمارة، رقم الشقة..."></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label small fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="أي ملاحظات خاصة بالتوصيل أو التخصيصات..."></textarea>
                    </div>

                    <div class="alert alert-info d-flex align-items-center mb-0" role="alert">
                        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                        <div>طريقة الدفع المتاحة حالياً: <strong>الدفع عند الاستلام (Cash on Delivery)</strong>.</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="fc-card p-4 sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-bag-check me-2 text-primary"></i>ملخص طلبك</h5>

                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start px-0">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold">@item.ProductName <span class="badge bg-secondary rounded-pill ms-1">x@item.Quantity</span></div>
                                    @if (item.SelectedCustomizations.Any())
                                    {
                                        <div class="small text-muted">
                                            @string.Join(" | ", item.SelectedCustomizations)
                                        </div>
                                    }
                                </div>
                                <span class="fw-bold text-primary">@item.TotalPrice.ToString("N0") ج.م</span>
                            </li>
                        }
                    </ul>

                    <div class="d-flex justify-content-between border-top pt-3 mb-4">
                        <span class="fs-5 fw-bold">الإجمالي النهائي:</span>
                        <span class="fs-4 fw-bold text-primary">@Model.Cart.GrandTotal.ToString("N0") ج.م</span>
                    </div>

                    <button type="submit" class="btn btn-fc-primary btn-lg w-100">
                        <i class="bi bi-check-circle-fill me-2"></i> تأكيد وإرسال الطلب
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>