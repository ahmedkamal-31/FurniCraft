@model IEnumerable<FurniCraft.Models.Order>

    @{
    ViewData["Title"] = "طلباتي";
    }

    <div class="container my-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-bag-check text-primary me-2"></i>
                    سجل طلباتي
                </h2>
                <p class="text-muted mb-0">تابع طلباتك وتفاصيل كل عملية شراء</p>
            </div>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-fc-outline">
                <i class="bi bi-shop me-1"></i>
                متابعة التسوق
            </a>
        </div>

        @if (!Model.Any())
    {
        <div class="fc-card p-5 text-center text-muted">
            <i class="bi bi-inbox display-3 mb-3 d-block"></i>
            <h5 class="fw-bold">لسه معملتش أي طلبات</h5>
            <p>لما تطلب أي منتج، هتلاقي تفاصيله هنا.</p>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-fc-primary mt-2">
                ابدأ التسوق
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var order in Model)
            {
                var statusText = order.Status switch
                {
                    "Pending" => "قيد الانتظار",
                    "Processing" => "قيد التحضير",
                    "Shipped" => "تم الشحن",
                    "Delivered" => "تم التسليم",
                    "Cancelled" => "ملغي",
                    _ => order.Status
                };

                var statusClass = order.Status switch
                {
                    "Pending" => "bg-warning text-dark",
                    "Processing" => "bg-info text-dark",
                    "Shipped" => "bg-primary",
                    "Delivered" => "bg-success",
                    "Cancelled" => "bg-danger",
                    _ => "bg-secondary"
                };

            <div class="col-12">
                <div class="fc-card p-4">

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 border-bottom pb-3 mb-3">

                        <div>
                            <h5 class="fw-bold mb-1">
                                طلب رقم #@order.OrderNumber
                            </h5>

                            <span class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i>
                                @order.OrderDate.ToLocalTime().ToString("yyyy/MM/dd - hh:mm tt")
                            </span>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            <span class="badge @statusClass px-3 py-2">
                                @statusText
                            </span>

                            <span class="fs-5 fw-bold text-success">
                                @order.TotalAmount.ToString("N0") ج.م
                            </span>
                        </div>

                    </div>

                    <div class="row g-3 align-items-center">

                        <div class="col-md-8">
                            <h6 class="fw-bold small text-muted mb-2">
                                المنتجات المطلوبة
                            </h6>

                            @foreach (var item in order.Items)
                                {
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">

                                <div>
                                    <span class="fw-bold">@item.Quantity ×</span>
                                    @item.Product?.Name
                                </div>

                                <span class="text-muted small">
                                    @item.TotalPrice.ToString("N0") ج.م
                                </span>

                            </div>
                                }

                            <div class="small text-muted mt-2">
                                <i class="bi bi-box-seam me-1"></i>
                                إجمالي القطع:
                                @order.Items.Sum(i => i.Quantity)
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="bg-light rounded-3 p-3">
                                <h6 class="fw-bold small mb-2">
                                    <i class="bi bi-truck me-1"></i>
                                    عنوان التوصيل
                                </h6>

                                <p class="small mb-1">@order.CustomerName</p>
                                <p class="small mb-1">@order.Phone</p>
                                <p class="small text-muted mb-0">
                                    @order.City، @order.Address
                                </p>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        <a asp-action="MyOrderDetails"
                           asp-route-id="@order.Id"
                           class="btn btn-sm btn-fc-outline">
                            عرض تفاصيل الطلب
                            <i class="bi bi-arrow-left ms-1"></i>
                        </a>
                    </div>

                </div>
            </div>
            }

        </div>
    }

    </div>
