@model FurniCraft.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "إنشاء حساب جديد";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="fc-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold">انضم إلى FurniCraft</h3>
                    <p class="text-muted small">أنشئ حسابك لتتمكن من اختيار وتخصيص أفضل قطع الأثاث</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="الاسم الثلاثي" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label small fw-semibold"></label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="City" class="form-label small fw-semibold"></label>
                            <input asp-for="City" class="form-control" placeholder="القاهرة" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Address" class="form-label small fw-semibold"></label>
                            <input asp-for="Address" class="form-control" placeholder="اسم الشارع / المنطقة" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-fc-primary w-100 py-2 fs-6 mb-3">إنشاء الحساب</button>
                </form>

                <div class="text-center mt-3 pt-3 border-top">
                    <p class="small mb-0">لديك حساب بالفعل؟ <a asp-action="Login" class="text-decoration-none fw-bold text-primary">سجل الدخول</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
