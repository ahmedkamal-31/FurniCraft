@model FurniCraft.ViewModels.ProductCreateViewModel

@{
    ViewData["Title"] = "تعديل المنتج";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">
                        <i class="bi bi-pencil-square text-primary me-2"></i>
                        تعديل المنتج
                    </h2>

                    <p class="text-muted mb-0">
                        تعديل بيانات المنتج والمخزون
                    </p>
                </div>

                <a asp-action="AdminIndex"
                   class="btn btn-fc-outline">
                    <i class="bi bi-arrow-right me-1"></i>
                    العودة
                </a>
            </div>

            <div class="fc-card p-4">

                <form asp-action="Edit"
                      asp-route-id="@Context.Request.RouteValues["id"]"
                      method="post"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name"
                               class="form-label fw-bold">
                            اسم المنتج
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description"
                               class="form-label fw-bold">
                            الوصف
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="BasePrice"
                                   class="form-label fw-bold">
                                السعر الأساسي
                            </label>

                            <div class="input-group">
                                <input asp-for="BasePrice"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       step="0.01" />

                                <span class="input-group-text">
                                    ج.م
                                </span>
                            </div>

                            <span asp-validation-for="BasePrice"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StockQuantity"
                                   class="form-label fw-bold">
                                كمية المخزون
                            </label>

                            <div class="input-group">
                                <input asp-for="StockQuantity"
                                       class="form-control"
                                       type="number"
                                       min="0" />

                                <span class="input-group-text">
                                    قطعة
                                </span>
                            </div>

                            <span asp-validation-for="StockQuantity"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <div class="mb-3 mt-3">
                        <label asp-for="CategoryId"
                               class="form-label fw-bold">
                            التصنيف
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="ViewBag.Categories"
                                class="form-select">

                            <option value="">
                                اختر التصنيف
                            </option>

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger">
                        </span>
                    </div>

                    @if (ViewBag.CurrentImage != null)
                    {
                    <div class="mb-3">
                        <label class="form-label fw-bold d-block">
                            الصورة الحالية
                        </label>

                        <img src="@ViewBag.CurrentImage"
                             class="rounded"
                             style="width: 140px; height: 140px; object-fit: cover;"
                             onerror="this.src='/images/products/default.jpg'" />
                    </div>
                    }

                    <div class="mb-4">
                        <label asp-for="ImageFile"
                               class="form-label fw-bold">
                            تغيير الصورة
                        </label>

                        <input asp-for="ImageFile"
                               type="file"
                               class="form-control"
                               accept="image/*" />

                        <span class="text-muted small">
                            اتركها فارغة للاحتفاظ بالصورة الحالية.
                        </span>

                        <span asp-validation-for="ImageFile"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-fc-primary">
                            <i class="bi bi-check-lg me-1"></i>
                            حفظ التعديلات
                        </button>

                        <a asp-action="AdminIndex"
                           class="btn btn-fc-outline">
                            إلغاء
                        </a>

                    </div>

                </form>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}