@model FurniCraft.Models.Category
@{
    ViewData["Title"] = "تعديل تصنيف";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="fc-card p-4">
                <h4 class="fw-bold mb-3">تعديل التصنيف</h4>
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-semibold">اسم التصنيف</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-semibold">الوصف</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-fc-primary w-100">تحديث</button>
                        <a asp-action="Index" class="btn btn-fc-outline w-100">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
