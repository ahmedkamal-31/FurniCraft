@model IEnumerable<FurniCraft.Models.Category>
@{
    ViewData["Title"] = "إدارة التصنيفات";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-grid-fill text-primary me-2"></i>إدارة التصنيفات</h2>
        <a asp-action="Create" class="btn btn-fc-primary"><i class="bi bi-plus-lg me-1"></i> إضافة تصنيف جديد</a>
    </div>

    <div class="fc-card p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>اسم التصنيف</th>
                        <th>الوصف</th>
                        <th>عدد المنتجات</th>
                        <th class="text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">لا توجد تصنيفات حالياً.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="fw-bold">@item.Name</td>
                                <td class="text-muted small">@(item.Description ?? " لا يوجد وصف")</td>
                                <td><span class="badge bg-secondary rounded-pill">@(item.Products?.Count ?? 0)</span></td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت تأكد من حذف هذا التصنيف؟');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
