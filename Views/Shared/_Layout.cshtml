@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@using FurniCraft.Models
@using FurniCraft.Services

@{
    // جلب الخدمات مباشرة من الـ Context لتجنب أخطاء @inject في Razor
    var signInManager = Context.RequestServices.GetRequiredService<SignInManager<ApplicationUser>>();
    var userManager = Context.RequestServices.GetRequiredService<UserManager<ApplicationUser>>();
    var cartService = Context.RequestServices.GetRequiredService<CartService>();

    var cart = cartService.GetCart();
    var cartCount = cart?.Items?.Sum(i => i.Quantity) ?? 0;
    var isSignedIn = signInManager.IsSignedIn(User);
    ApplicationUser? currentUser = null;
    var isAdmin = false;

    if (isSignedIn)
    {
        currentUser = await userManager.GetUserAsync(User);
        if (currentUser != null)
        {
            isAdmin = await userManager.IsInRoleAsync(currentUser, "Admin");
        }
    }
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="FurniCraft - منصتك لاقتناء الأثاث المنزلي العصري بأعلى جودة وأفضل الأسعار." />
    <title>@ViewData["Title"] - FurniCraft</title>

    <!-- Arabic-friendly font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/furnicraft-theme.css" asp-append-version="true" />
</head>
<body>

    <!-- =========================
         NAVBAR
         ========================= -->
    <header>
        <nav class="navbar navbar-expand-lg fc-navbar fixed-top" aria-label="التنقل الرئيسي">
            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand fc-brand d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-house-door-fill fc-brand-icon" aria-hidden="true"></i>
                    <span>Furni<span>Craft</span></span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMain"
                        aria-controls="navbarMain"
                        aria-expanded="false"
                        aria-label="فتح القائمة">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation -->
                <div class="collapse navbar-collapse" id="navbarMain">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1" aria-hidden="true"></i>
                                الرئيسية
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-shop me-1" aria-hidden="true"></i>
                                المتجر
                            </a>
                        </li>
                    </ul>

                    <!-- Actions -->
                    <div class="d-flex align-items-center gap-3">

                        <!-- Cart -->
                        <a asp-controller="Cart"
                           asp-action="Index"
                           class="btn btn-outline-dark border-0 position-relative p-2"
                           aria-label="السلة (@cartCount)">
                            <i class="bi bi-bag fs-5" aria-hidden="true"></i>
                            @if (cartCount > 0)
                            {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @cartCount
                            </span>
                            }
                        </a>

                        @if (isSignedIn)
                        {
                            <!-- User Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-fc-outline dropdown-toggle btn-sm"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-person-circle me-1" aria-hidden="true"></i>
                                @(currentUser?.FullName ?? User.Identity?.Name ?? "حسابي")
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                                <!-- My Orders -->
                                <li>
                                    <a class="dropdown-item" asp-controller="Orders" asp-action="MyOrders">
                                        <i class="bi bi-bag-check me-2" aria-hidden="true"></i>
                                        طلباتي
                                    </a>
                                </li>

                                @if (isAdmin)
                                    {
                                <li><hr class="dropdown-divider" /></li>

 <!-- Admin Dashboard -->
                                <li>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-2" aria-hidden="true"></i>
                                        لوحة التحكم
                                    </a>
                                </li>

 <!-- Products -->
                                <li>
                                    <a class="dropdown-item" asp-controller="Products" asp-action="AdminIndex">
                                        <i class="bi bi-box-seam me-2" aria-hidden="true"></i>
                                        إدارة المنتجات
                                    </a>
                                </li>

 <!-- Orders -->
                                <li>
                                    <a class="dropdown-item" asp-controller="Orders" asp-action="AdminIndex">
                                        <i class="bi bi-receipt-cutoff me-2" aria-hidden="true"></i>
                                        إدارة الطلبات
                                    </a>
                                </li>
                                    }

                                <li><hr class="dropdown-divider" /></li>

                                <!-- Logout -->
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>
                                            تسجيل الخروج
                                        </button>
                                    </form>
                                </li>

                            </ul>
                        </div>
                        }
                        else
                        {
 <!-- Login -->
                        <a class="btn btn-fc-outline btn-sm" asp-controller="Account" asp-action="Login">دخول</a>

 <!-- Register -->
                        <a class="btn btn-fc-primary btn-sm" asp-controller="Account" asp-action="Register">حساب جديد</a>
                        }

                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- =========================
         MAIN CONTENT
         ========================= -->
    <main role="main" class="flex-shrink-0 fc-main">
        @RenderBody()
    </main>

    <!-- =========================
         FOOTER
         ========================= -->
    <footer class="fc-footer py-5 mt-auto">
        <div class="container">
            <div class="row g-4">

                <!-- About -->
                <div class="col-lg-4 col-md-6">
                    <h5 class="fc-brand text-white mb-3">Furni<span>Craft</span></h5>
                    <p class="small text-muted">
                        منصتك الأولى لاقتناء وتخصيص الأثاث المنزلي العصري والراقي بأعلى جودة وأفضل الأسعار.
                    </p>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="fc-footer-heading">روابط سريعة</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li class="mb-2"><a asp-controller="Products" asp-action="Index">المتجر</a></li>
                        <li class="mb-2"><a asp-controller="Cart" asp-action="Index">السلة</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fc-footer-heading">تواصل معنا</h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><i class="bi bi-geo-alt me-2" aria-hidden="true"></i>القاهرة، مصر</li>
                        <li class="mb-2"><i class="bi bi-envelope me-2" aria-hidden="true"></i>support@furnicraft.com</li>
                    </ul>
                </div>

                <!-- Delivery -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fc-footer-heading">الدفع والتوصيل</h6>
                    <p class="small text-muted">
                        نوفر خدمة الدفع عند الاستلام (Cash on Delivery) لضمان رضاكم التام.
                    </p>
                </div>

            </div>

            <hr class="my-4 border-secondary" />

            <div class="text-center small text-muted">
                &copy; @DateTime.Now.Year - FurniCraft. جميع الحقوق محفوظة.
            </div>
        </div>
    </footer>

    <!-- =========================
         SCRIPTS
         ========================= -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/furnicraft-animations.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
