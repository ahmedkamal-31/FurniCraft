@using Microsoft.AspNetCore.Identity
@using FurniCraft.Models
@using FurniCraft.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject CartService CartService

@{
    var cartCount = CartService.GetCart().Items.Sum(i => i.Quantity);
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FurniCraft</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/furnicraft-theme.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg fc-navbar fixed-top">
            <div class="container">
                <a class="navbar-brand fc-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door-fill text-primary"></i>
                    Furni<span>Craft</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">المتجر</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark border-0 position-relative p-2">
                            <i class="bi bi-bag fs-5"></i>
                            @if (cartCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @cartCount
                                </span>
                            }
                        </a>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            var isAdmin = user != null && await UserManager.IsInRoleAsync(user, "Admin");

                            if (isAdmin)
                            {
                                <div class="dropdown me-2">
                                    <button class="btn btn-outline-dark btn-sm rounded-pill dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-speedometer2 me-1"></i> لوحة الإدارة
                                    </button>
                                    <ul class="dropdown-menu shadow-sm">
                                        <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index"><i class="bi bi-grid me-2"></i>التصنيفات</a></li>
                                        <li><a class="dropdown-item" asp-controller="Products" asp-action="AdminIndex"><i class="bi bi-box-seam me-2"></i>المنتجات</a></li>
                                        <li><a class="dropdown-item" asp-controller="Orders" asp-action="AdminIndex"><i class="bi bi-receipt-cutoff me-2"></i>إدارة الطلبات</a></li>
                                    </ul>
                                </div>
                            }

                            <div class="dropdown">
                                <button class="btn btn-fc-outline dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i> @(user?.FullName ?? User.Identity?.Name)
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="MyOrders"><i class="bi bi-bag-check me-2"></i>طلباتي</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>تسجيل الخروج
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-fc-outline btn-sm" asp-controller="Account" asp-action="Login">دخول</a>
                            <a class="btn btn-fc-primary btn-sm" asp-controller="Account" asp-action="Register">حساب جديد</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-shrink-0" style="margin-top: 80px; padding-bottom: 60px;">
        @RenderBody()
    </main>

    <footer class="fc-footer py-5 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fc-brand text-white mb-3">Furni<span>Craft</span></h5>
                    <p class="small text-muted">منصتك الأولى لاقتناء وتخصيص الأثاث المنزلي العصري والراقي بأعلى جودة وأفضل الأسعار.</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fc-footer-heading">روابط سريعة</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Products" asp-action="Index">المتجر</a></li>
                        <li class="mb-2"><a asp-controller="Cart" asp-action="Index">السلة</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fc-footer-heading">تواصل معنا</h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><i class="bi bi-geo-alt me-2"></i>القاهرة، مصر</li>
                        <li class="mb-2"><i class="bi bi-envelope me-2"></i>support@furnicraft.com</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fc-footer-heading">الدفع والتوصيل</h6>
                    <p class="small text-muted">نوفر خدمة الدفع عند الاستلام (Cash on Delivery) لضمان رضاكم التام.</p>
                </div>
            </div>
            <hr class="my-4 border-secondary">
            <div class="text-center small text-muted">
                &copy; @DateTime.Now.Year - FurniCraft. جميع الحقوق محفوظة.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
